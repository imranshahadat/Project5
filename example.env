# tracing
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""

# ==============================
# Pinecone Vector Database
# ==============================
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="rag-knowledge-base4627b74apinecone"
PINECONE_NAMESPACE=""
PINECONE_ENVIRONMENT=""
PINECONE_DIMENSION=1024
PINECONE_CLOUD="aws"
PINECONE_REGION="aped-27b4-a"
PINECONE_READ_TIMEOUT=180


# ==============================
# Neon PostgreSQL Database
# ==============================
DATABASE_URL="postgresql://neondb_-aoi9.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ==============================
# AWS Credentials
# ==============================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY="/3BBJnvtR"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="imranali-"

# ==============================
# Vercel AI Gateway
# ==============================
VERCEL_BASE_URL="https://ai-gateway.vercel.sh/v1"
VERCEL_API_KEY=""

# ==============================
# Embedding Configuration
# ==============================
EMBEDDING_PROVIDER="vercel"
EMBEDDING_MODEL="cohere/embed-v4.0"
EMBEDDING_DIMENSIONS=1024

# ==============================
# LLM Configuration
# ==============================
LLM_PROVIDER="vercel"
LLM_MODEL="inception/mercury-3"

# ==============================
# Text Chunking
# ==============================
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ==============================
# Vector Retrieval
# ==============================
DEFAULT_RETRIEVAL_K=4
HYBRID_FETCH_K=20

# ==============================
# Reranking
# ==============================
USE_RERANKER=true
RERANKER_MODEL=""

# ==============================
# Retrieval Configuration
# ==============================
SIMILARITY_THRESHOLD=0.70



# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_PARALLEL=true
INPUT_GUARDS=pii,injection,toxicity
OUTPUT_GUARDS=pii,system_prompt_leak
PII_BLOCK_INPUT=false        # redact user PII, don't reject
PII_BLOCK_OUTPUT=true        # never let PII leak in the answer
TOXICITY_BANNED_WORDS=       # CSV, empty = no-op

# Chat
CHAT_HISTORY_TURNS=6
CHAT_REWRITE_FOLLOWUP=true
CHAT_MAX_ANSWER_CHARS=2000
CHAT_NO_EVIDENCE_MSG=I could not find supporting evidence in the available documents.

# Access control (off until ingestion tags chunks with tenant_id)
ACCESS_CONTROL_ENABLED=false